{
  "ensure-utf8": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/ensure_utf8.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
