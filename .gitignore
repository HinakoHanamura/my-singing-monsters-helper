# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Captured game frames: large, machine-specific, not source
captures/

# Template assets are intentionally tracked, but keep scratch crops out
assets/templates/_scratch/

# YOLO artifacts
*.pt
runs/
datasets/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local logs
*.log

# Calibration output: regenerable from captures/ via tools/calibrate.py
reports/

# Output of tests/manual/test_eyes.py: a frame of this machine's game window
tests/manual/*.png

# pytest report artifacts, regenerable via tools/run_suite.py
junit*.xml

# Local-only notes, planning documents, and scratchpad
.agents/
scratch/

# Temporarily ignore all markdown documentation
*.md
**/*.md

