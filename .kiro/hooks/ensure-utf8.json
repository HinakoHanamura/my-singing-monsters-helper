{
  "version": "v1",
  "hooks": [
    {
      "name": "Ensure UTF-8 Source Encoding",
      "trigger": "PostToolUse",
      "description": "在任何文件写入之后自动把 GBK 编码的源文件转回 UTF-8，防止中文注释导致 SyntaxError。",
      "matcher": "fs_write|str_replace|fs_append",
      "action": {
        "type": "command",
        "command": "python tools/ensure_utf8.py",
        "timeout": 30
      }
    }
  ]
}